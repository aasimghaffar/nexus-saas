APP_NAME="Nexus SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The web installer at /install writes your real database settings.
DB_CONNECTION=sqlite

# Safe pre-install defaults; the installer switches sessions to the
# database driver once your database is migrated.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe billing (optional — Billing runs in preview mode without) ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
CASHIER_CURRENCY=usd

# --- Public demo server only ---
NEXUS_DEMO=false

VITE_APP_NAME="${APP_NAME}"
